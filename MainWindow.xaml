<ui:FluentWindow x:Class="MinNote.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="MinNote • Bảng Viết &amp; Vẽ Hình Toán Học - Đỗ Miinh Math" 
        Icon="Assets/app.ico"
        Height="850" Width="1366"
        MinHeight="650" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ExtendsContentIntoTitleBar="False"
        WindowBackdropType="None"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        AllowDrop="True" Drop="MainWindow_Drop" DragOver="MainWindow_DragOver">
    <Grid Background="#0F172A">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. Header Bar: Tiêu đề & Công cụ điều khiển cửa sổ -->
        <Border x:Name="TopHeaderBar" Grid.Row="0" MouseLeftButtonDown="TopHeaderBar_MouseLeftButtonDown" Background="#0F172A" Height="40" Padding="12,0,8,0"
                BorderBrush="#1E293B" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <!-- Trailing / Right: Nút chức năng & Window Controls -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- CẬP NHẬT / UPDATE -->
                    <ui:Button x:Name="BtnUpdateTop" Appearance="Transparent"
                               Icon="{ui:SymbolIcon ArrowSync24}"
                               Content="Cập nhật"
                               FontSize="11" Padding="6,4"
                               Margin="0,0,6,0"
                               Cursor="Hand"
                               ToolTip="Kiểm tra bản cập nhật mới từ GitHub"
                               Click="BtnUpdateTop_Click" />

                    <!-- BẢN QUYỀN / LICENSE -->
                    <ui:Button x:Name="BtnLicenseTop" Appearance="Transparent"
                               Icon="{ui:SymbolIcon ShieldCheckmark24}"
                               Content="Bản quyền: Đang kiểm tra..."
                               FontSize="11" Padding="8,4"
                               Margin="0,0,6,0"
                               Cursor="Hand"
                               ToolTip="Thông tin bản quyền và Mã máy (Bấm để xem / kích hoạt)"
                               Click="BtnLicenseTop_Click" />

                    <!-- TOÀN MÀN HÌNH (F11) - 1 NÚT DUY NHẤT -->
                    <ui:Button x:Name="BtnFullScreenTop" Appearance="Transparent"
                               Icon="{ui:SymbolIcon FullScreenMaximize24}"
                               ToolTip="Bật/Tắt Toàn Màn Hình (F11)"
                               Click="BtnFullScreenTop_Click" Padding="6,2" Margin="0,0,2,0" />

                    <!-- Nút thu nhỏ, phóng to, đóng cửa sổ -->
                    <Border Width="1" Height="18" Background="#334155" Margin="0,0,8,0" />
                    <ui:Button x:Name="BtnWinMin" Appearance="Transparent"
                               Icon="{ui:SymbolIcon Subtract24}"
                               ToolTip="Thu nhỏ cửa sổ"
                               Click="BtnWinMin_Click" Padding="6,2" Margin="0,0,2,0" />
                    <ui:Button x:Name="BtnWinMax" Appearance="Transparent"
                               Icon="{ui:SymbolIcon Maximize24}"
                               ToolTip="Phóng to / Khôi phục kích thước"
                               Click="BtnWinMax_Click" Padding="6,2" Margin="0,0,2,0" />
                    <ui:Button x:Name="BtnWinClose" Appearance="Danger"
                               Icon="{ui:SymbolIcon Dismiss24}"
                               ToolTip="Đóng ứng dụng"
                               Click="BtnWinClose_Click" Padding="6,2" />
                </StackPanel>

                <!-- Leading / Left: Logo & Tiêu đề ứng dụng -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#0284C7" CornerRadius="6" Width="24" Height="24" Margin="0,0,8,0">
                        <TextBlock Text="M" FontWeight="Bold" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="MinNote" FontWeight="Bold" FontSize="13" Foreground="#F8FAFC" VerticalAlignment="Center" />
                    <Border Background="#1E293B" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtAppVersion" Text="v0.0.1.0" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text=" • Bảng Viết &amp; Vẽ Hình Toán Học" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. WebView2 Khung tương tác Canvas Bảng Viết & Overlay Loading -->
        <Grid Grid.Row="1" Background="#0F172A">
            <wv2:WebView2 x:Name="WvWhiteboard" />

            <!-- Loading overlay or fallback state -->
            <Border x:Name="PanelLoading" 
                    Background="#0F172A"
                    HorizontalAlignment="Stretch" 
                    VerticalAlignment="Stretch"
                    Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                    <ui:ProgressRing x:Name="LoadingRing" IsIndeterminate="True" Width="42" Height="42" Margin="0,0,0,16" />
                    <TextBlock x:Name="TxtLoadingTitle" Text="Đang khởi tạo MinNote Canvas..." 
                               FontSize="14" FontWeight="SemiBold" 
                               HorizontalAlignment="Center"
                               Foreground="#F8FAFC" />
                    <TextBlock x:Name="TxtLoadingSubtitle" Text="Vui lòng chờ trong giây lát" 
                               FontSize="12" Margin="0,6,0,0"
                               HorizontalAlignment="Center"
                               Foreground="#94A3B8" />
                    <ui:Button x:Name="BtnRetryInit" Content="Tải lại Bảng viết" Appearance="Primary"
                               Icon="{ui:SymbolIcon ArrowSync24}"
                               Margin="0,16,0,0" HorizontalAlignment="Center"
                               Visibility="Collapsed" Click="BtnRetryInit_Click" />
                </StackPanel>
            </Border>

            <!-- Khóa theo bản quyền: WebView2 bị ẩn khi máy không có quyền "whiteboard" -->
            <Border x:Name="PanelLocked" Background="#0F172A" Visibility="Collapsed">
                <Border Background="#1E293B" CornerRadius="12" Padding="28,24" MaxWidth="520"
                        HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <ui:SymbolIcon x:Name="IconLocked" Symbol="LockClosed24" FontSize="36" Foreground="#F59E0B" HorizontalAlignment="Center" />
                        <TextBlock x:Name="TxtLockedTitle" Text="MinNote đang bị khóa" FontSize="17" FontWeight="Bold"
                                   Foreground="#F8FAFC" HorizontalAlignment="Center" Margin="0,10,0,6" />
                        <TextBlock x:Name="TxtLockedReason" FontSize="13" Foreground="#CBD5E1" TextWrapping="Wrap"
                                   TextAlignment="Center" />
                        <Border Background="#0F172A" CornerRadius="6" Padding="12,8" Margin="0,16,0,0">
                            <DockPanel>
                                <ui:Button DockPanel.Dock="Right" Content="Chép" Click="BtnCopyMid_Click" Padding="10,3" />
                                <TextBlock VerticalAlignment="Center" Foreground="#94A3B8" FontSize="12">
                                    Mã máy: <Run x:Name="RunLockedMid" FontFamily="Consolas" FontWeight="Bold" Foreground="#2DD4BF" />
                                </TextBlock>
                            </DockPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                            <ui:Button x:Name="BtnRecheckLicense" Content="Kiểm tra lại" Appearance="Primary"
                                       Icon="{ui:SymbolIcon ArrowSync24}" Click="BtnRecheckLicense_Click" Margin="0,0,8,0" />
                            <ui:Button Content="Kích hoạt / chi tiết" Click="BtnLicenseTop_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
