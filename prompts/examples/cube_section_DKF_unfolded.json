{
  "schema": "mn-geo-motion/2.0",
  "title": "Lập phương ABCD.A'B'C'D' — thiết diện (DKF) & mặt A'B'C'D' trải phẳng",
  "is3D": true,
  "meta": {
    "problem": "Cho hình lập phương ABCD.A'B'C'D'. Gọi K, F lần lượt là trung điểm của A'B', B'C'. Dựng thiết diện của hình lập phương cắt bởi mặt phẳng (DKF). Vẽ riêng mặt A'B'C'D'.",
    "parents": ["A", "B", "A1", "B1"],
    "children_locked": ["A' (quay 90°)", "D (chiều sâu)", "C, B', C', D' (tổng véc-tơ)", "K, F (trung điểm)", "P, Q, I, N (giao điểm đồng phẳng)", "D1 (quay 90°)", "C1 (tổng véc-tơ)"]
  },
  "ops": [
    {"op": "cube", "name": "ABCD.A'B'C'D'", "edge": 2.8, "x": -3.0, "y": -2.2, "depthAngle": 135, "depthRatio": 0.5, "effect": "chalk", "step": "Dựng hình lập phương (cha: A, B)"},
    {"op": "midpoint", "id": "K", "s": "A'-B'", "effect": "pop", "step": "K là trung điểm A'B'"},
    {"op": "midpoint", "id": "F", "s": "B'-C'", "effect": "pop", "step": "F là trung điểm B'C'"},
    {"op": "intersection_ll", "id": "P", "l1": "K-F", "l2": "D'-A'", "drawExtensions": true, "dashedExtensions": true, "effect": "pop", "step": "Trong (A'B'C'D'): P = KF ∩ D'A'"},
    {"op": "intersection_ll", "id": "Q", "l1": "K-F", "l2": "D'-C'", "drawExtensions": true, "dashedExtensions": true, "effect": "pop", "step": "Trong (A'B'C'D'): Q = KF ∩ D'C'"},
    {"op": "intersection_ll", "id": "I", "l1": "D-P", "l2": "A-A'", "effect": "pop", "step": "Trong (ADD'A'): I = DP ∩ AA'"},
    {"op": "intersection_ll", "id": "N", "l1": "D-Q", "l2": "C-C'", "effect": "pop", "step": "Trong (CDD'C'): N = DQ ∩ CC'"},
    {"op": "connect_polygon", "pts": ["D", "I", "K", "F", "N"], "dashedEdges": ["F-N", "N-D"], "fill": "rgba(15, 23, 42, 0.08)", "effect": "fade", "step": "Thiết diện DIKFN"},
    {"op": "point_free", "id": "A1", "label": "A'", "flat": true, "x": 1.4, "y": -1.6, "step": "Mặt A'B'C'D' trải phẳng: cha A'"},
    {"op": "point_free", "id": "B1", "label": "B'", "flat": true, "x": 4.2, "y": -1.6, "step": "cha B'"},
    {"op": "rotate", "id": "D1", "label": "D'", "center": "A1", "point": "B1", "angleDeg": 90, "k": 1, "step": "D' = quay B' quanh A' 90°"},
    {"op": "point_sum", "id": "C1", "label": "C'", "a": "B1", "b": "D1", "c": "A1", "step": "C' = B' + D' − A' ⇒ luôn là hình vuông"},
    {"op": "connect_polygon", "pts": ["A1", "B1", "C1", "D1"], "step": "Hình vuông A'B'C'D'"},
    {"op": "midpoint", "id": "K1", "label": "K", "s": "A1-B1", "effect": "pop"},
    {"op": "midpoint", "id": "F1", "label": "F", "s": "B1-C1", "effect": "pop"},
    {"op": "segments", "solid": ["K1-F1", "A1-C1"], "aux": true, "step": "KF // A'C'"}
  ],
  "motion": {"preset": "domiinh", "loop": true, "handPen": true}
}
