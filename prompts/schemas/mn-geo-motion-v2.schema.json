{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minnote.app/schemas/mn-geo-motion-v2.schema.json",
  "title": "MinNote Parametric Geometry & Continuous Motion Schema (mn-geo-motion/2.0 — v0.0.9.12)",
  "description": "Chuẩn JSON hai chiều kết nối các mô hình AI (ChatGPT, Claude, Gemini, DeepSeek, Grok, Local LLM), hệ thống Macro & Tuple DSL rút gọn 70%–85% code, bảng dựng hình ràng buộc MinNote và trình xuất video chuyển động liên tục BetaTikz (tikzvid-project/1).",
  "type": "object",
  "required": ["schema"],
  "anyOf": [
    { "required": ["ops"] },
    { "required": ["geometry"] }
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "mn-geo-motion/2.0",
      "description": "Định danh phiên bản chuẩn JSON của MinNote Motion Bridge."
    },
    "title": {
      "type": "string",
      "description": "Tiêu đề ngắn gọn của hình vẽ."
    },
    "t": {
      "type": "string",
      "description": "Bí danh rút gọn của trường title trong chế độ siêu gọn."
    },
    "is3D": {
      "type": "boolean",
      "description": "Cờ đánh dấu hình học không gian 3D (bật kiểm tra bao lồi và nét đứt tự động)."
    },
    "meta": {
      "$ref": "#/$defs/MetaInfo"
    },
    "checks": {
      "$ref": "#/$defs/FiveGateChecks"
    },
    "ops": {
      "type": "array",
      "minItems": 1,
      "description": "Danh sách thao tác dựng hình tham số theo thứ tự tô-pô (DAG): chấp nhận đối tượng chuẩn/Macro GeoOp hoặc mảng Tuple DSL siêu gọn.",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/GeoOp" },
          {
            "type": "array",
            "minItems": 2,
            "description": "Cú pháp Tuple mảng siêu gọn v0.0.9.12 (ví dụ: [\"pyramid\",\"S.ABCD\",\"quad\",\"free\"], [\"mid\",\"M\",\"S-C\"], [\"segs\",[\"B-M\"],[\"A-C\"]])."
          }
        ]
      }
    },
    "geometry": {
      "$ref": "#/$defs/CompiledGeometry"
    },
    "motion": {
      "$ref": "#/$defs/MotionTimeline"
    },
    "m": {
      "$ref": "#/$defs/MotionTimeline",
      "description": "Bí danh rút gọn của trường motion trong chế độ siêu gọn."
    },
    "exports": {
      "$ref": "#/$defs/ExportPayloads"
    }
  },
  "$defs": {
    "MetaInfo": {
      "type": "object",
      "additionalProperties": true,
      "required": ["title", "is3D"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Tên hình vẽ hoặc bài toán."
        },
        "problem": {
          "type": "string",
          "description": "Nguyên văn đề bài Toán (nếu có)."
        },
        "is3D": {
          "type": "boolean",
          "description": "True nếu là hình không gian 3D / khối tròn xoay; False nếu là hình phẳng 2D."
        },
        "spaceType": {
          "type": "string",
          "enum": ["plane_2d", "solid_3d", "revolution_3d", "analytic_oxy", "analytic_oxyz"],
          "description": "Phân loại không gian hình học tại Cổng kiểm định 1."
        },
        "author": {
          "type": "string"
        },
        "generator": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "pageId": {
          "type": "string"
        }
      }
    },
    "FiveGateChecks": {
      "type": "object",
      "additionalProperties": false,
      "description": "Bảng tự kiểm định 5 cổng hình học bắt buộc trước khi sinh mảng ops (giúp khóa suy luận với Structured Outputs).",
      "properties": {
        "gate1_space": {
          "type": "string",
          "description": "Phân loại 2D/3D và hệ tọa độ gốc chống suy biến góc nhìn (+x sang phải, +y lên trên)."
        },
        "gate2_dag_anchors": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Danh sách duy nhất các đỉnh gốc tự do."
        },
        "gate3_coplanar_intersections": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Chứng nhận mặt phẳng đồng phẳng cho mọi phép giao intersection_ll và kiểm tra det != 0."
        },
        "gate4_dashed_edges": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Danh sách đầy đủ các cạnh khuất / đường xuyên khối phải đặt dashed: true."
        },
        "gate5_motion_story": {
          "type": "string",
          "description": "Nhịp điệu sư phạm của kịch bản chuyển động và điểm nhấn kết luận."
        }
      }
    },
    "EffectId": {
      "type": "string",
      "enum": [
        "draw",
        "chalk",
        "chalk_dust",
        "glow",
        "pop",
        "pulse",
        "fade",
        "wipe",
        "stamp",
        "spring",
        "zoom",
        "slide",
        "laser_scan",
        "center_out",
        "draw_then_fill",
        "arrow_slide",
        "measure_brace",
        "fourier_epicycles",
        "morph_bezier",
        "mirror_flip",
        "extrude_rise",
        "xray_hidden",
        "typewriter",
        "graph_trace",
        "mention_glow",
        "chalk_box",
        "double_underline",
        "target_reticle",
        "water_ripple",
        "starburst",
        "checkmark_stamp",
        "cross_strike",
        "wiggle_alert"
      ]
    },
    "EasingId": {
      "type": "string",
      "enum": [
        "linear",
        "easeIn",
        "easeOut",
        "easeInOut",
        "smoothstep",
        "smootherstep",
        "spring",
        "bump",
        "thereback"
      ]
    },
    "PresetId": {
      "type": "string",
      "enum": [
        "domiinh",
        "manim",
        "3d_standard",
        "geo3d",
        "custom"
      ]
    },
    "TimeRange": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "description": "Khoảng thời gian chuẩn hóa [tStart, tEnd] thuộc [0, 1] cho engine BetaTikz."
    },
    "PointPair": {
      "oneOf": [
        {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "string" }
        },
        {
          "type": "string",
          "pattern": "^[^\\s-]+-[^\\s-]+$",
          "description": "Cặp điểm viết gọn dạng chuỗi \"A-C\", \"S-O\", \"A'-C'\"."
        }
      ]
    },
    "NumericOrRef": {
      "oneOf": [
        { "type": "number", "exclusiveMinimum": 0 },
        { "type": "string", "minLength": 1 }
      ]
    },
    "GeoOp": {
      "type": "object",
      "required": ["op"],
      "additionalProperties": false,
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "point_free",
            "point_sum",
            "midpoint",
            "point_on_segment",
            "ratio_point",
            "point_on_line",
            "foot_perp",
            "intersection_ll",
            "intersection_lc",
            "intersection_cc",
            "tangent_point",
            "tangents_from_point",
            "common_tangent",
            "circle",
            "point_on_circle",
            "line_parallel",
            "point_parallel",
            "line_perp",
            "point_perp",
            "rotate",
            "angle_bisector",
            "segment",
            "segments",
            "points",
            "line",
            "ray",
            "arc",
            "arc3",
            "sector",
            "cone",
            "cylinder",
            "sphere",
            "frustumCone",
            "pyramid",
            "prism",
            "equilateral_triangle",
            "square_2d",
            "circumcircle",
            "incircle",
            "orthocenter",
            "centroid",
            "polygon_base",
            "connect_polygon",
            "section",
            "polygon_fill",
            "right_angle",
            "angle_mark",
            "tick_mark",
            "free",
            "pts",
            "sum",
            "mid",
            "on",
            "on_line",
            "on_circle",
            "foot",
            "par",
            "perp",
            "inter",
            "inter_lc",
            "inter_cc",
            "tan",
            "ctan",
            "rot",
            "point_rot",
            "rotation",
            "bis",
            "bisector",
            "seg",
            "segs",
            "poly",
            "sec",
            "fill",
            "right",
            "ang",
            "tick"
          ]
        },
        "id": { "type": "string" },
        "label": { "type": "string" },
        "name": { "type": "string", "description": "Tên khối đa diện trong Macro pyramid/prism (ví dụ: \"S.ABCD\", \"ABC.A'B'C'\")." },
        "x": { "type": "number", "description": "Hoành độ toán học (+x sang phải)." },
        "y": { "type": "number", "description": "Tung độ toán học (+y hướng lên trên)." },
        "a": { "type": "string" },
        "b": { "type": "string" },
        "c": { "type": "string" },
        "d": { "type": "string" },
        "p": { "type": "string" },
        "point": { "type": "string", "description": "Điểm gốc đem quay trong lệnh rotate." },
        "v": { "type": "string" },
        "vertex": { "type": "string" },
        "through": { "type": "string" },
        "o": { "type": "string" },
        "center": { "type": "string" },
        "apex": { "type": "string" },
        "topCenter": { "type": "string" },
        "bottomCenter": { "type": "string" },
        "start": { "type": "string" },
        "end": { "type": "string" },
        "foot": { "type": "string" },
        "footId": { "type": "string" },
        "centerId": { "type": "string" },
        "rim": { "type": "string" },
        "r": { "$ref": "#/$defs/NumericOrRef" },
        "r1": { "$ref": "#/$defs/NumericOrRef" },
        "r2": { "$ref": "#/$defs/NumericOrRef" },
        "radius": { "$ref": "#/$defs/NumericOrRef" },
        "h": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "baseType": {
          "type": "string",
          "enum": [
            "quad",
            "convex_quad",
            "parallelogram",
            "rect",
            "rectangle",
            "square",
            "rhombus",
            "trapezoid",
            "triangle",
            "equilateral",
            "right_triangle"
          ]
        },
        "altitude": {
          "type": "string",
          "enum": [
            "free",
            "SA",
            "SB",
            "SC",
            "SD",
            "face_SAB",
            "face_SAD",
            "center",
            "upright",
            "oblique"
          ]
        },
        "base": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string" }
        },
        "top": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string" }
        },
        "upright": { "type": "boolean" },
        "oblique": { "type": "boolean" },
        "parallel": { "type": "string" },
        "from": { "type": "string" },
        "side": {
          "oneOf": [
            { "type": "string", "enum": ["upper", "lower", "top", "bottom", "left", "right"] },
            { "type": "number", "exclusiveMinimum": 0 }
          ]
        },
        "exclude": { "type": "string" },
        "otherThan": { "type": "string" },
        "ids": { "type": "array", "items": { "type": "string" } },
        "id1": { "type": "string" },
        "id2": { "type": "string" },
        "onOpposite": { "type": "boolean" },
        "intersectOpposite": { "type": "boolean" },
        "inner": { "type": "boolean" },
        "on": { "type": "integer", "enum": [1, 2] },
        "ccw": { "type": "boolean" },
        "startDeg": { "type": "number" },
        "endDeg": { "type": "number" },
        "showFoot": { "type": "boolean" },
        "drawCircle": { "type": "boolean" },
        "drawCenter": { "type": "boolean" },
        "drawAltitudes": { "type": "boolean" },
        "drawMedians": { "type": "boolean" },
        "drawBisectors": { "type": "boolean" },
        "drawRadii": { "type": "boolean" },
        "drawChord": { "type": "boolean" },
        "drawThales": { "type": "boolean" },
        "drawDiagonals": { "type": "boolean" },
        "drawAltitude": { "type": "boolean" },
        "drawAxis": { "type": "boolean" },
        "drawGeneratrices": { "type": "boolean" },
        "drawRay": { "type": "boolean" },
        "asRay": { "type": "boolean" },
        "drawSegments": { "type": "boolean" },
        "drawTangents": { "type": "boolean" },
        "markRightAngles": { "type": "boolean" },
        "ratio": { "type": "number" },
        "k": { "type": "number" },
        "angleDeg": { "type": "number" },
        "angle": { "type": "number" },
        "ang": {
          "oneOf": [
            { "type": "number" },
            { "type": "string" }
          ]
        },
        "s": { "$ref": "#/$defs/PointPair" },
        "l1": { "$ref": "#/$defs/PointPair" },
        "l2": { "$ref": "#/$defs/PointPair" },
        "a1": { "type": "string" },
        "b1": { "type": "string" },
        "a2": { "type": "string" },
        "b2": { "type": "string" },
        "line": { "$ref": "#/$defs/PointPair" },
        "circle": { "$ref": "#/$defs/PointPair" },
        "c1": { "$ref": "#/$defs/PointPair" },
        "c2": { "$ref": "#/$defs/PointPair" },
        "circle1": { "$ref": "#/$defs/PointPair" },
        "circle2": { "$ref": "#/$defs/PointPair" },
        "which": {
          "type": "integer",
          "enum": [0, 1]
        },
        "pts": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 2,
              "items": { "type": "string" }
            },
            {
              "type": "string",
              "pattern": "^[^\\s-]+-[^\\s-]+(-[^\\s-]+)*$"
            },
            {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "oneOf": [
                  {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 3,
                    "items": { "type": "number" }
                  },
                  {
                    "type": "object",
                    "required": ["x", "y"],
                    "properties": {
                      "x": { "type": "number" },
                      "y": { "type": "number" },
                      "show": { "type": "boolean" },
                      "label": { "type": "string" },
                      "noDot": { "type": "boolean" }
                    }
                  }
                ]
              }
            }
          ]
        },
        "solid": {
          "type": "array",
          "items": { "$ref": "#/$defs/PointPair" }
        },
        "edges": {
          "type": "array",
          "items": { "$ref": "#/$defs/PointPair" }
        },
        "dashedEdges": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dashed": {
          "oneOf": [
            { "type": "boolean" },
            {
              "type": "array",
              "items": { "$ref": "#/$defs/PointPair" }
            }
          ]
        },
        "extDashed": { "type": "boolean" },
        "dashedExtensions": { "type": "boolean" },
        "drawExtensions": { "type": "boolean" },
        "drawDropSegment": { "type": "boolean" },
        "drawSegment": { "type": "boolean" },
        "markRightAngle": { "type": "boolean" },
        "asLine": { "type": "boolean" },
        "bothSides": { "type": "boolean" },
        "keepDirection": { "type": "boolean" },
        "perp": { "type": "boolean" },
        "noDot": { "type": "boolean" },
        "show": { "type": "boolean" },
        "aux": { "type": "boolean" },
        "arrow": { "type": "boolean" },
        "kind": {
          "type": "string",
          "enum": ["segment", "line", "ray"]
        },
        "n": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "fill": { "type": "string" },
        "color": { "type": "string" },
        "extColor": { "type": "string" },
        "width": { "type": "number", "minimum": 0 },
        "explicitColor": { "type": "boolean" },
        "explicitWidth": { "type": "boolean" },
        "step": {
          "type": "string",
          "description": "Lời dẫn sư phạm ngắn gọn hiển thị trong bảng Kịch bản của MinNote."
        },
        "note": { "type": "string" },
        "effect": { "$ref": "#/$defs/EffectId" },
        "fx": { "$ref": "#/$defs/EffectId" },
        "easing": { "$ref": "#/$defs/EasingId" },
        "durationMul": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 5.0
        },
        "delayMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        },
        "pauseAfter": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "rev": { "type": "boolean" },
        "tempHide": { "type": "boolean" },
        "showGuides": { "type": "boolean" },
        "tRange": { "$ref": "#/$defs/TimeRange" }
      }
    },
    "PointDef": {
      "type": "object",
      "required": ["t"],
      "additionalProperties": true,
      "properties": {
        "t": {
          "type": "string",
          "enum": ["free", "mid", "on", "foot", "sum", "inter", "vec", "path", "rot", "len", "polar", "bis", "ctan", "p3d"]
        },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "a": { "type": "string" },
        "b": { "type": "string" },
        "c": { "type": "string" },
        "p": { "type": "string" },
        "o": { "type": "string" },
        "k": { "type": "number" },
        "ang": { "type": "number" },
        "seg": { "type": "boolean" },
        "perp": { "type": "boolean" },
        "l1": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "string" }
        },
        "l2": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "string" }
        },
        "c1": {
          "oneOf": [
            { "type": "boolean" },
            { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string" } }
          ]
        },
        "c2": {
          "oneOf": [
            { "type": "boolean" },
            { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string" } }
          ]
        },
        "inner": { "type": "boolean" },
        "which": {
          "oneOf": [
            { "type": "integer", "enum": [0, 1] },
            { "type": "boolean" }
          ]
        },
        "kind": { "type": "string" },
        "on": {
          "oneOf": [
            { "type": "string" },
            { "type": "integer", "enum": [1, 2] }
          ]
        },
        "pts": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "GeoPoint": {
      "type": "object",
      "required": ["id", "def"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "show": { "type": "boolean" },
        "named": { "type": "boolean" },
        "noDot": { "type": "boolean" },
        "noName": { "type": "boolean" },
        "hidden": { "type": "boolean" },
        "nx": { "type": "number", "description": "Hoành độ chuẩn hóa trên lưới TikZ (+x sang phải)." },
        "ny": { "type": "number", "description": "Tung độ chuẩn hóa trên lưới TikZ (+y lên trên)." },
        "def": { "$ref": "#/$defs/PointDef" }
      }
    },
    "GeoShape": {
      "type": "object",
      "required": ["id", "kind", "pts"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "kind": {
          "type": "string",
          "enum": [
            "segment",
            "line",
            "ray",
            "extend",
            "circle",
            "arc",
            "arc3",
            "sector",
            "polygon",
            "right",
            "angle",
            "tick",
            "plane",
            "cone",
            "cylinder",
            "sphere",
            "frustumCone",
            "ellipse",
            "parabola",
            "hyperbola",
            "locus",
            "solid"
          ]
        },
        "pts": {
          "type": "array",
          "items": { "type": "string" }
        },
        "color": { "type": "string" },
        "width": { "type": "number", "minimum": 0 },
        "dashed": { "type": "boolean" },
        "aux": { "type": "boolean" },
        "fill": { "type": "string" },
        "arrow": { "type": "boolean" },
        "plain": { "type": "boolean" },
        "n": { "type": "integer", "minimum": 1, "maximum": 3 },
        "hidden": { "type": "boolean" },
        "look3": { "type": "boolean" },
        "group": { "type": "string" }
      }
    },
    "CompiledGeometry": {
      "type": "object",
      "required": ["points", "shapes"],
      "additionalProperties": false,
      "properties": {
        "points": {
          "oneOf": [
            {
              "type": "array",
              "items": { "$ref": "#/$defs/GeoPoint" }
            },
            {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/GeoPoint" }
            }
          ]
        },
        "shapes": {
          "type": "array",
          "items": { "$ref": "#/$defs/GeoShape" }
        },
        "bbox": {
          "type": "object",
          "required": ["x0", "y0", "x1", "y1"],
          "additionalProperties": true,
          "properties": {
            "x0": { "type": "number" },
            "y0": { "type": "number" },
            "x1": { "type": "number" },
            "y1": { "type": "number" },
            "width": { "type": "number" },
            "height": { "type": "number" }
          }
        }
      }
    },
    "CameraKeyframe": {
      "type": "object",
      "required": ["t"],
      "additionalProperties": false,
      "properties": {
        "t": { "type": "number", "minimum": 0, "maximum": 1 },
        "shiftX": { "type": "number" },
        "shiftY": { "type": "number" },
        "scale": { "type": "number", "exclusiveMinimum": 0 },
        "rotation": { "type": "number" },
        "easing": { "$ref": "#/$defs/EasingId" }
      }
    },
    "StepSubItem": {
      "type": "object",
      "required": ["kind", "refId"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["point", "shape", "item", "stroke"]
        },
        "refId": { "type": "string" },
        "rev": { "type": "boolean" }
      }
    },
    "MotionStep": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "kind": {
          "type": "string",
          "enum": ["point", "shape", "group", "item", "stroke"]
        },
        "refId": { "type": "string" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/StepSubItem" }
        },
        "mode": {
          "type": "string",
          "enum": ["construct", "cue"]
        },
        "customTitle": { "type": "string" },
        "effect": { "$ref": "#/$defs/EffectId" },
        "easing": { "$ref": "#/$defs/EasingId" },
        "durationMul": { "type": "number", "minimum": 0.2, "maximum": 5.0 },
        "delayMs": { "type": "number", "minimum": 0 },
        "pauseAfter": { "type": "number", "minimum": 0, "maximum": 10 },
        "rev": { "type": "boolean" },
        "tempHide": { "type": "boolean" },
        "showGuides": { "type": "boolean" },
        "enabled": { "type": "boolean" },
        "tRange": { "$ref": "#/$defs/TimeRange" }
      }
    },
    "MotionTimeline": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "preset": { "$ref": "#/$defs/PresetId" },
        "defaultEffect": { "$ref": "#/$defs/EffectId" },
        "fps": { "type": "integer", "minimum": 12, "maximum": 120 },
        "durationSec": { "type": "number", "minimum": 1, "maximum": 600 },
        "holdEndSec": { "type": "number", "minimum": 0, "maximum": 30 },
        "speed": { "type": "number", "minimum": 0.2, "maximum": 4.0 },
        "loop": { "type": "boolean" },
        "pauseBetween": { "type": "boolean" },
        "handPen": { "type": "boolean" },
        "followCamera": { "type": "boolean" },
        "springCamera": { "type": "boolean" },
        "orbit3d": { "type": "boolean" },
        "cameraKeyframes": {
          "type": "array",
          "items": { "$ref": "#/$defs/CameraKeyframe" }
        },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/MotionStep" }
        }
      }
    },
    "BetaTikzProject": {
      "type": "object",
      "required": ["format", "state"],
      "additionalProperties": true,
      "properties": {
        "format": {
          "type": "string",
          "const": "tikzvid-project/1"
        },
        "exported": { "type": "number" },
        "project": {
          "type": "object",
          "properties": {
            "id": { "type": "integer" },
            "name": { "type": "string" },
            "created": { "type": "number" },
            "updated": { "type": "number" }
          }
        },
        "state": {
          "type": "object",
          "required": ["out_tikz"],
          "properties": {
            "tikz": { "type": "string" },
            "out_tikz": { "type": "string" },
            "prompt": { "type": "string" },
            "storyboard": { "type": "string" },
            "edit_prompt": { "type": "string" },
            "style": { "type": "string" },
            "t": { "type": "string" }
          }
        },
        "revisions": { "type": "array" },
        "jobs": { "type": "array" }
      }
    },
    "ExportPayloads": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "tikzStatic": { "type": "string" },
        "tikzBetaAnimated": { "type": "string" },
        "animateInlineTex": { "type": "string" },
        "betatikzProject": { "$ref": "#/$defs/BetaTikzProject" }
      }
    }
  }
}
