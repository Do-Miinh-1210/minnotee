<Window x:Class="MinNote.Views.MinNoteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="MinNote"
        Width="470"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Style="{x:Null}"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Background="#0F172A"
            BorderBrush="#334155"
            BorderThickness="1"
            CornerRadius="14"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.48" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Draggable Header -->
            <Border Grid.Row="0"
                    Padding="18,16,16,12"
                    BorderBrush="#1E293B"
                    BorderThickness="0,0,0,1"
                    Background="Transparent"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <DockPanel>
                    <Border DockPanel.Dock="Left"
                            x:Name="IconBadge"
                            Width="36" Height="36"
                            CornerRadius="9"
                            Background="#1E3A8A"
                            BorderBrush="#3B82F6"
                            BorderThickness="1"
                            Margin="0,0,12,0"
                            VerticalAlignment="Top">
                        <ui:SymbolIcon x:Name="IconGlyph"
                                       Symbol="Info24"
                                       FontSize="19"
                                       Foreground="#93C5FD"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                    </Border>
                    <Button DockPanel.Dock="Right"
                            Click="BtnCancel_Click"
                            Width="28" Height="28"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#94A3B8"
                            FontSize="14"
                            Cursor="Hand"
                            ToolTip="Đóng (Esc)"
                            Content="✕"
                            VerticalAlignment="Top" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtTitle"
                                   Text="Thông báo"
                                   FontSize="15.5"
                                   FontWeight="SemiBold"
                                   Foreground="#F8FAFC"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="TxtSubtitle"
                                   Text="MinNote • Bảng Viết &amp; Vẽ Hình Toán Học"
                                   FontSize="11.5"
                                   Foreground="#94A3B8"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Body -->
            <StackPanel Grid.Row="1" Margin="18,14,18,16">
                <ScrollViewer MaxHeight="300"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="TxtMessage"
                               FontSize="13.5"
                               LineHeight="21"
                               Foreground="#E2E8F0"
                               TextWrapping="Wrap" />
                </ScrollViewer>

                <TextBox x:Name="TxtPromptInput"
                         Visibility="Collapsed"
                         Margin="0,12,0,0"
                         Padding="10,8"
                         FontSize="13.5"
                         Background="#1E293B"
                         Foreground="#F8FAFC"
                         CaretBrush="#60A5FA"
                         BorderBrush="#334155"
                         BorderThickness="1" />
            </StackPanel>

            <!-- Footer -->
            <Border Grid.Row="2"
                    Padding="18,12"
                    BorderBrush="#1E293B"
                    BorderThickness="0,1,0,0"
                    Background="#0B1220"
                    CornerRadius="0,0,13,13">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnCancel"
                            Content="Hủy"
                            Click="BtnCancel_Click"
                            Padding="16,8"
                            MinWidth="86"
                            Margin="0,0,8,0"
                            Background="#1E293B"
                            BorderBrush="#334155"
                            BorderThickness="1"
                            Foreground="#E2E8F0"
                            FontSize="13"
                            FontWeight="Medium"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8" />
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button x:Name="BtnPrimary"
                            Content="Đã hiểu"
                            Click="BtnPrimary_Click"
                            IsDefault="True"
                            Padding="18,8"
                            MinWidth="96"
                            Background="#2563EB"
                            BorderBrush="#3B82F6"
                            BorderThickness="1"
                            Foreground="#FFFFFF"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
