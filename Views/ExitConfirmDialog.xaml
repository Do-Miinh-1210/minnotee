<Window x:Class="MinNote.Views.ExitConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Xác nhận thoát MinNote"
        Width="490"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Background="#171923"
            BorderBrush="#2E364D"
            BorderThickness="1"
            CornerRadius="12"
            Padding="22,18"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="6" Opacity="0.48" Color="#000000" />
        </Border.Effect>
        <StackPanel>
            <!-- Header -->
            <DockPanel Margin="0,0,0,12" MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent">
                <Border DockPanel.Dock="Left"
                        x:Name="IconBadge"
                        Width="36" Height="36"
                        CornerRadius="9"
                        Background="#1E3A8A"
                        Margin="0,0,12,0">
                    <ui:SymbolIcon x:Name="IconGlyph" Symbol="Save24" FontSize="19" Foreground="#93C5FD"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Button DockPanel.Dock="Right"
                        Click="BtnCancel_Click"
                        Width="28" Height="28"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#94A3B8"
                        FontSize="14"
                        Cursor="Hand"
                        ToolTip="Đóng hộp thoại (Esc)"
                        Content="✕"
                        VerticalAlignment="Top" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTitle"
                               Text="Lưu thay đổi trước khi thoát?"
                               FontSize="15.5"
                               FontWeight="SemiBold"
                               Foreground="#F8FAFC" />
                    <TextBlock x:Name="TxtSubtitle"
                               Text="MinNote • Bảo vệ dữ liệu &amp; các sheet"
                               FontSize="11.5"
                               Foreground="#94A3B8"
                               Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- Body Card -->
            <Border Background="#11131B"
                    BorderBrush="#252B3D"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,12"
                    Margin="0,0,0,12">
                <TextBlock x:Name="TxtMessage"
                           FontSize="13"
                           LineHeight="20"
                           Foreground="#E2E8F0"
                           TextWrapping="Wrap" />
            </Border>

            <!-- Checkbox "Không hỏi lại..." (chỉ hiện khi đã tự động lưu) -->
            <CheckBox x:Name="ChkDontAskAgain"
                      Content="Không hỏi lại khi mọi thay đổi đã được tự động lưu"
                      Foreground="#CBD5E1"
                      FontSize="12"
                      Margin="2,0,0,14"
                      Visibility="Collapsed" />

            <!-- Actions -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCancel"
                        Content="Ở lại (Hủy)"
                        Click="BtnCancel_Click"
                        IsCancel="True"
                        Padding="14,8"
                        MinWidth="96"
                        Margin="0,0,8,0"
                        Background="#1E2433"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        Foreground="#E2E8F0"
                        FontSize="12.5"
                        FontWeight="Medium"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="7" />
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="BtnDiscard"
                        Content="Không lưu &amp; Thoát"
                        Click="BtnDiscard_Click"
                        Padding="14,8"
                        MinWidth="122"
                        Margin="0,0,8,0"
                        Background="#3B1822"
                        BorderBrush="#7F1D1D"
                        BorderThickness="1"
                        Foreground="#FCA5A5"
                        FontSize="12.5"
                        FontWeight="SemiBold"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="7" />
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="BtnSaveAndExit"
                        Content="Lưu &amp; Thoát"
                        Click="BtnSaveAndExit_Click"
                        IsDefault="True"
                        Padding="16,8"
                        MinWidth="126"
                        Background="#2563EB"
                        BorderBrush="#3B82F6"
                        BorderThickness="1"
                        Foreground="#FFFFFF"
                        FontSize="12.5"
                        FontWeight="SemiBold"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="7" />
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
