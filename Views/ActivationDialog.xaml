<ui:FluentWindow x:Class="MinNote.Views.ActivationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Kích hoạt Bản quyền MinNote" 
        Height="680" Width="840"
        MinHeight="580" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">
    <Grid Margin="20,10,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="Kích hoạt Bản quyền Trực tuyến • MinNote" ShowMaximize="True" ShowMinimize="True" />

        <!-- 2. Scrollable Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,10,0,10">
            <StackPanel>
                <!-- Header Card: Trạng thái bản quyền hiện tại -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" 
                        CornerRadius="8" Padding="16" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Image Source="/Assets/app.ico" Width="44" Height="44" Margin="0,0,16,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="MinNote • Bảng Viết &amp; Vẽ Hình Toán Học" FontSize="16" FontWeight="Bold" />
                                <Border x:Name="BadgeLicenseStatus" Background="#1A10B981" CornerRadius="4" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtBadgeStatus" Text="ĐANG KIỂM TRA..." Foreground="#10B981" FontSize="10" FontWeight="Bold" />
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="TxtLicenseDetail" Text="Đang kết nối hệ thống bản quyền..." 
                                       FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>

                        <ui:Button x:Name="BtnRefreshStatus" Grid.Column="2" Appearance="Secondary" Icon="{ui:SymbolIcon ArrowSync24}" 
                                   Content="Kiểm tra Trực tuyến" Padding="12,6" VerticalAlignment="Center" Click="BtnRefreshStatus_Click" 
                                   ToolTip="Đồng bộ và kiểm tra trạng thái giấy phép từ máy chủ bản quyền" />
                    </Grid>
                </Border>

                <!-- Machine ID Box -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" 
                        CornerRadius="8" Padding="16" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Mã máy tính định danh (Dùng chung với MatrixExamAI):" FontWeight="SemiBold" FontSize="12.5" />
                            <TextBlock x:Name="TxtMachineId" Text="XXXX-XXXX-XXXX" FontFamily="Consolas, monospace" FontSize="20" FontWeight="Bold" 
                                       Foreground="#0d9488" Margin="0,4,0,2" />
                            <TextBlock x:Name="TxtHardwareDisplay" Text="Windows Hardware Guid" FontSize="11" 
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>

                        <ui:Button x:Name="BtnCopyMid" Grid.Column="1" Appearance="Primary" Icon="{ui:SymbolIcon Copy24}" 
                                   Content="Sao chép Mã máy" Padding="14,8" VerticalAlignment="Center" Click="BtnCopyMid_Click" 
                                   ToolTip="Sao chép mã máy tính để gửi Admin Đỗ Minh kích hoạt bản quyền" />
                    </Grid>
                </Border>

                <!-- Two-Column Activation Box: Nhập Key & Quét QR -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="340" />
                    </Grid.ColumnDefinitions>

                    <!-- Cột trái: Kích hoạt thủ công qua mã hoặc liên hệ -->
                    <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" 
                            CornerRadius="8" Padding="16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <ui:SymbolIcon Symbol="Key24" FontSize="16" Foreground="#0d9488" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Kích hoạt Trực tiếp &amp; Hỗ trợ" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Text="Hướng dẫn kích hoạt bản quyền MinNote:" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,0,6" />
                            <TextBlock Text="1. Sao chép Mã máy tính ở trên gửi Admin Đỗ Minh qua Zalo." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBlock Text="2. Sau khi Admin cấp quyền trên hệ thống, bấm nút 'Kiểm tra Trực tuyến' để phần mềm tự động mở khóa." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,4" />
                            <TextBlock Text="3. MinNote sử dụng cùng 1 Mã máy với MatrixExamAI. Bản quyền MatrixExamAI đã bao gồm đầy đủ quyền sử dụng MinNote." FontSize="11" Foreground="#0d9488" TextWrapping="Wrap" Margin="0,0,0,12" />

                            <ui:Button x:Name="BtnContactZalo" Appearance="Secondary" Icon="{ui:SymbolIcon Chat24}" 
                                       Content="Mở Zalo Admin (033.999.8261)" HorizontalAlignment="Stretch" Padding="12,8" Click="BtnContactZalo_Click" />

                            <TextBlock Text="Phần mềm tự động lưu chữ ký số bản quyền offline sau khi kích hoạt thành công, cho phép bạn tiếp tục sử dụng ngay cả khi không có mạng Internet." 
                                       FontSize="10.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Margin="0,16,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Cột phải: Thanh toán VietQR & Thông tin Admin -->
                    <Border Grid.Column="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" 
                            CornerRadius="8" Padding="16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <ui:SymbolIcon Symbol="QrCode24" FontSize="16" Foreground="#0d9488" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Đăng ký &amp; Kích hoạt qua VietQR" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Gói dịch vụ -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Gói dịch vụ:" VerticalAlignment="Center" FontSize="11.5" FontWeight="Medium" Margin="0,0,8,0" />
                                <ComboBox x:Name="CmbPricingPackage" Grid.Column="1" SelectionChanged="CmbPricingPackage_SelectionChanged">
                                    <ComboBoxItem Content="MinNote Bản quyền Trọn đời • 350.000 đ" Tag="minnote|lifetime|350000" IsSelected="True" />
                                    <ComboBoxItem Content="MinNote 1 Năm • 199.000 đ" Tag="minnote|12|199000" />
                                    <ComboBoxItem Content="MatrixExamAI Pro (Bao gồm MinNote) • 899.000 đ" Tag="pro|12|899000" />
                                </ComboBox>
                            </Grid>

                            <!-- Ảnh VietQR -->
                            <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" 
                                    CornerRadius="6" Background="White" Width="160" Height="160" HorizontalAlignment="Center" Margin="0,4,0,8">
                                <Image x:Name="ImgVietQr" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform" />
                            </Border>

                            <TextBlock Text="Quét QR bằng ứng dụng Ngân hàng để thanh toán tự động với nội dung là Mã máy tính của bạn." 
                                       FontSize="10.5" TextAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />

                            <!-- Thông tin Admin -->
                            <Border Background="#0A0D9488" CornerRadius="4" Padding="8,6">
                                <StackPanel>
                                    <TextBlock Text="Vietcombank: 1017919118 • DO HUYNH BINH MINH" FontSize="10.5" FontWeight="SemiBold" Foreground="#0d9488" />
                                    <TextBlock Text="Hỗ trợ &amp; Zalo: 033.999.8261 (Thầy Đỗ Minh)" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- InfoNotification -->
                <ui:InfoBar x:Name="InfoActivation" Margin="0,4,0,0" IsOpen="False" />
            </StackPanel>
        </ScrollViewer>

        <!-- 3. Bottom Bar -->
        <Grid Grid.Row="2" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TxtFooterNote" Text="MinNote kết nối trực tiếp hệ thống máy chủ bản quyền Cloud đồng bộ bảo mật." 
                       FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />

            <ui:Button x:Name="BtnClose" Grid.Column="1" Appearance="Secondary" Content="Đóng" 
                       Padding="20,6" Click="BtnClose_Click" />
        </Grid>
    </Grid>
</ui:FluentWindow>
